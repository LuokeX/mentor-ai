# 正式环境入口：
#   3300 明文 → 307 跳到 https://<同一主机>:3301（/health/* 例外直通）
#   3301 HTTPS → TLS 终结后转发 app:3300，是唯一实际提供应用的入口
#
# 为什么不用 80/443：与测试环境保持同一套端口规律便于对照排查，且本机 80/443 留给
# 校内其它服务；代价是所有访问必须显式带 :3301（浏览器不会自动补非标准端口）。
#
# 设计取舍（与测试环境 infra/nginx/test.conf.template 保持一致）：
# - 应用容器不再直接发布明文端口（见 docker-compose.yml 的 app 服务），避免存在绕过 HTTPS 的入口。
# - 跳转用 307 而不是 301/302：301/302 允许客户端把 POST 改写成 GET（历史上大量客户端这么做），
#   而 /api/v1/** 里有登录、提问等 POST；307 要求保持方法与请求体。307 同时是临时跳转语义，
#   证书不受信需要临时排查时，浏览器不会像 301 那样把跳转长期缓存下来。
# - /health/* 例外直通应用：发布流程与监控用明文探活（curl http://<主机>:3300/health/ready）不必跟随跳转，
#   健康接口只返回状态与数据库可用性，不涉及任何敏感数据。
# - 非标准 HTTPS 端口下 Host 用 $http_host（保留 :3301）：应用据此生成的绝对地址才不会丢端口。
# - 暂不下发 HSTS：当前用 infra/certs/ 的本地自签证书（scripts/gen-cert.sh --env=prod 生成），
#   一旦被 HSTS 记住，证书不受信时浏览器会直接拒绝访问，连「继续访问」的机会都没有。
#   换成学校或公网 CA 签发的证书后，取消下面 HSTS 那行的注释。
#
# 证书文件（由 scripts/gen-cert.sh --env=prod 生成，可替换为学校签发的证书）：
#   /etc/nginx/certs/fullchain.pem  服务器证书
#   /etc/nginx/certs/privkey.pem    私钥，权限 600

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

# 明文入口：只做跳转（健康检查放行）
server {
  listen 3300;
  server_name ${SERVER_NAME};

  location = /health/live {
    proxy_pass http://app:3300;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto http;
  }

  location = /health/ready {
    proxy_pass http://app:3300;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto http;
  }

  location / {
    # $host 不含端口，这里显式补 3301；$request_uri 带查询串，原样保留路径与参数
    return 307 https://$host:3301$request_uri;
  }
}

server {
  listen 3301 ssl;
  http2 on;
  server_name ${SERVER_NAME};

  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_tickets off;
  # HSTS：换成学校或公网 CA 签发的证书后再取消注释（自签证书阶段保持关闭）
  # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  client_max_body_size 2m;
  proxy_read_timeout 75s;

  # 语音输入：录音转 WAV 后 base64 上传，请求体可达数 MB，单独放宽（全局仍为 2m）
  location = /api/v1/chat/transcriptions {
    client_max_body_size 12m;
    proxy_pass http://app:3300;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  # 备课资料上传：原始 body 最大 20MB，单独放宽（全局仍为 2m）
  location ^~ /api/v1/chat/lesson-prep/workspaces/ {
    client_max_body_size 25m;
    proxy_pass http://app:3300;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }

  location = /api/v1/auth/login {
    limit_req zone=login burst=5 nodelay;
    proxy_pass http://app:3300;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    proxy_pass http://app:3300;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    # 聊天 SSE 要求不缓冲
    proxy_set_header Connection "";
    proxy_buffering off;
  }
}
