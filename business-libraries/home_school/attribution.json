{
  "module": "home_school",
  "version": "1.0.0",
  "computed": {
    "conflict": "MAX(scores)"
  },
  "branches": [
    {
      "pri": 5,
      "when": "conflict >= 4",
      "level": "high",
      "blocked": false,
      "ruleId": "home-school-conflict-high",
      "primaryAttribution": "家校沟通升级",
      "secondaryAttributions": ["信息不对称", "边界协商不足"],
      "reasons": ["量表显示家长情绪、公开冲突或沟通容器处于高关注状态。"],
      "toolTags": ["home_school", "conflict", "boundary", "high"]
    },
    {
      "pri": 100,
      "level": "low",
      "blocked": false,
      "ruleId": "home-school-default",
      "primaryAttribution": "沟通结构待澄清",
      "secondaryAttributions": [],
      "reasons": ["当前未达到高冲突阈值，建议先用事实澄清和共识确认推进。"],
      "toolTags": ["home_school", "clarify"]
    }
  ],
  "actions": [
    {
      "title": "完成事实-诉求-边界记录",
      "detail": "记录家长原话、事实依据、核心诉求和可承诺边界，再约定下一次沟通节点。",
      "status": "pending"
    }
  ],
  "tools": [
    {
      "title": "先跟后带沟通卡",
      "content": "先确认感受，再澄清事实，最后提出可执行的下一步。"
    }
  ]
}
