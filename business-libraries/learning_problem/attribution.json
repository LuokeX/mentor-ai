{
  "module": "learning_problem",
  "version": "1.0.0",
  "computed": {
    "learningLoad": "MAX(scores)"
  },
  "branches": [
    {
      "pri": 10,
      "when": "learningLoad >= 4",
      "level": "focused",
      "blocked": false,
      "ruleId": "learning-problem-focused",
      "primaryAttribution": "学习策略与执行断点",
      "secondaryAttributions": ["学习动机不足", "任务拆解不足"],
      "reasons": ["量表显示学习问题集中在策略、动机或执行链路，需要先做小目标支架。"],
      "toolTags": ["learning_problem", "strategy", "execution"]
    },
    {
      "pri": 100,
      "level": "observe",
      "blocked": false,
      "ruleId": "learning-problem-default",
      "primaryAttribution": "学习问题待定位",
      "secondaryAttributions": [],
      "reasons": ["当前信息不足以直接定位学习断点，建议先补齐作业、课堂和复习证据。"],
      "toolTags": ["learning_problem", "observe"]
    }
  ],
  "actions": [
    {
      "title": "拆解一个本周学习任务",
      "detail": "选择一个真实学习任务，拆成可观察、可完成、可复盘的三个小目标。",
      "status": "pending"
    }
  ],
  "tools": [
    {
      "title": "ZPD 小目标支架",
      "content": "现有水平｜最近目标｜支持方式｜完成证据｜复盘时间"
    }
  ]
}
