POSTGRES_USER=mentor_admin
POSTGRES_PASSWORD=replace-with-a-long-admin-database-password
POSTGRES_DB=mentor_ai
APP_DB_USER=mentor_app
APP_DB_PASSWORD=replace-with-a-different-long-app-password
DATABASE_URL=postgres://mentor_app:replace-with-a-different-long-app-password@localhost:5434/mentor_ai_dev
MIGRATION_DATABASE_URL=postgres://mentor_admin:replace-with-a-long-admin-database-password@localhost:5434/mentor_ai_dev
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方模型名（deepseek-v4-flash / deepseek-v4-pro 为兼容别名，会路由到对应正式模型）
DEEPSEEK_ROUTER_MODEL=deepseek-flash
DEEPSEEK_GENERATOR_MODEL=deepseek-flash
DEEPSEEK_AGREEMENT_VERSION=
# 全局默认超时：思考模式下首字延迟可达数秒，不要低于 30000
DEEPSEEK_TIMEOUT_MS=30000
# Agent 对话记忆（只追加前缀 + token 预算）
# 历史 token 预算：超出后从最旧处整块丢弃（每次丢弃会让缓存前缀断裂一次）
AI_AGENT_HISTORY_TOKEN_BUDGET=24000
# 单轮回答输出上限（含思考链，按输出 token 计费）
AI_AGENT_MAX_OUTPUT_TOKENS=4096
# 压缩保留比例：超预算时把摘要之后的原文保留到预算的该比例，其余并入摘要（P2 生效）
AI_AGENT_COMPACTION_KEEP_RATIO=0.5
# Agent 单轮工具轮次上限（默认 8；随只读工具集扩充上调，超额时用已生成文本收尾）
AI_AGENT_MAX_TOOL_ROUNDS=8
# 启用的 Agent 工具清单（逗号分隔，取值见 AI 中心「运行时配置」的工具名；留空 = 按上下文裁剪后全部启用）
AI_AGENT_ENABLED_TOOLS=
# strict tool calling 试点（DeepSeek Beta）：逗号分隔的 purpose 列表，可选 semantic_safety、instrument_recommendation；
# 留空 = 全部走 json_object（默认，行为与既有版本一致）；启用后 strict 通道不可用会自动回退 json_object，
# 并在 ai_model_calls.error_code 里留下 strict:* / http:400 记录，供 AI 中心按原因观察。
AI_STRICT_JSON_PURPOSES=
# ---- 文档工作区沙箱（Phase 1 默认关闭）----
# 启用时设置 SANDBOX_ENABLED=true，并用 `--profile sandbox` 启动 sandbox-runner。
# SANDBOX_RUNNER_TOKEN 必须是强随机值（例如 openssl rand -hex 32），app 与 runner 共用；
# 为空时 runner 拒绝启动，app 的沙箱工具保持不可用。
SANDBOX_ENABLED=false
SANDBOX_RUNNER_URL=http://sandbox-runner:3200
SANDBOX_RUNNER_TOKEN=
# runner 资源限额（一般不需要改）
SANDBOX_MAX_FILE_BYTES=20971520
SANDBOX_MAX_WORKSPACE_BYTES=104857600
SANDBOX_MAX_FILES=50
SANDBOX_WORKSPACE_TTL_MS=1800000
EMBEDDING_ENABLED=true
# 学段过滤（三库资源/知识库文档的「适用学部」）：默认 false = 所有教师看到全部内容；
# 内容按学段细分后置 true，即按教师任教年级过滤（标签与数据无需改动）。
SCHOOL_SECTION_FILTER_ENABLED=false
# dashscope | ollama：切换后存量向量需全量重建（`pnpm resources:reindex`）
EMBEDDING_PROVIDER=dashscope
# 百炼（dashscope）配置：provider=dashscope 时生效
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# 语音输入与回答朗读（百炼）：
# - ASR 复用上面的 compatible-mode 端点；TTS 走下面的原生端点
# - SPEECH_ENABLED=false 可整体关闭；学校数据模式为 local 时也会自动禁用
# - 录音只在 HTTPS 或 localhost 下可用（浏览器安全上下文限制）
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
SPEECH_ENABLED=true
# 识别与朗读模型：换模型系列时端点、入参与返回结构都会变
# （qwen-audio-* 走原生 multimodal-generation（识别还需显式 format）/ SpeechSynthesizer，
#   qwen3-asr-*、qwen3-tts-* 走 OpenAI 兼容端点与 multimodal-generation），
# 代码按模型名前缀自动选择，无需手改端点
ASR_MODEL=qwen-audio-3.0-asr-flash
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanlingxi
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_TIMEOUT_MS=8000
# provider=ollama 时使用；正式 compose 已不再内置 ollama，需自备服务
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
SMS_PROVIDER=mock
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
APP_BASE_URL=http://localhost:3000
# SERVER_NAME 仅作记录；浏览器校验的是 infra/certs/fullchain.pem 里的 SAN，必须包含实际访问地址
SERVER_NAME=mentor.example.edu.cn
# 会话 Cookie 是否只在 HTTPS 下发送（代码默认：production 构建下为 true）：
# 正式与测试环境的唯一入口都是 nginx 的 HTTPS（3300/3400 只做 307 跳转），保持 true；
# 置 false 只适用于应用临时用明文端口直接对外的情况，否则登录后浏览器不会回传会话
SESSION_COOKIE_SECURE=true

# ---- 统一身份验证（OIDC，可选；四项齐全后登录页显示"统一身份登录"）----
# 对接学校统一身份平台：issuer 为发现端点（/.well-known/openid-configuration）所在源，
# client 需要在身份平台登记，redirect_uri 必须与登记的白名单完全一致，例如
# https://your-domain/api/v1/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# ---- 登录页「选择测试账户」（仅测试/UAT 环境用）----
# 为 true 时登录页显示预置测试账号列表，点选后自动填入手机号与密码，再走正常登录
# （不新增接口、不绕过认证）。测试编排 docker-compose.test.yml 已直接注入 true，
# 正式编排不注入该变量、也不要在 .env 里打开，避免登录页出现测试账号信息。
# 账号清单与维护口径见 app/utils/test-accounts.ts。
NUXT_PUBLIC_SHOW_TEST_ACCOUNTS=false

# Docker Compose 会把以上服务变量同时映射为 Nuxt 的 NUXT_* 运行时变量，
# 裸机运行生产构建时请自行设置对应的 NUXT_DATABASE_URL、
# NUXT_ENCRYPTION_KEY、NUXT_DEEPSEEK_API_KEY 等变量。
